      "id": "2a037b08-8a59-4701-a20f-a115cf0f4ddb",
      "name": "HTML Extract (Cards)",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        688,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nfor (let idx = 0; idx < $input.all().length; idx++) {\n  const item = $input.all()[idx].json;\n  const hrefs = item.hrefs || [];\n  const prices = item.list_prices || [];\n  const pageInfo = $('Category Pages (Level 1)').all()[idx]?.json || {};\n  const cards = hrefs.map((href, i) => {\n    const cleanPath = String(href).replace(/^(\\.\\.\\/)+/, '');\n    return {\n      url: 'https://books.toscrape.com/catalogue/' + cleanPath,\n      list_price_raw: prices[i] || null,\n      category_from_menu: pageInfo.category_from_menu || 'Fantasy',\n      list_page: pageInfo.list_page || ''\n    };\n  });\n  results.push({ json: { cards } });\n}\nreturn results;"
      },
