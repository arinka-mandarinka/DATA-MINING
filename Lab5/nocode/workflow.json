      "parameters": {
        "jsCode": "// Уровень 1: 2 страницы категории Fantasy (20 + 20 = 40 книг, >= 30 по условию)\nreturn [\n  {\n    json: {\n      category_from_menu: 'Fantasy',\n      list_page: 'https://books.toscrape.com/catalogue/category/books/fantasy_19/page-1.html'\n    }\n  },\n  {\n    json: {\n      category_from_menu: 'Fantasy',\n      list_page: 'https://books.toscrape.com/catalogue/category/books/fantasy_19/page-2.html'\n    }\n  }\n];"
      },
