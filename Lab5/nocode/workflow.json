      "id": "74cfa011-c98d-4e6a-a6c3-1953c3050b73",
      "name": "HTML Extract (Book Details)",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        1824,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const RATING_MAP = { One: 1, Two: 2, Three: 3, Four: 4, Five: 5 };\nconst parsePrice = (raw) => {\n  const cleaned = String(raw || '').replace(/[^\\d.]/g, '');\n  return cleaned ? Number(parseFloat(cleaned).toFixed(2)) : null;\n};\n\nconst loopItems = $('Loop Over Items').all();\nconst out = [];\n\nfor (let i = 0; i < $input.all().length; i++) {\n  const d = $input.all()[i].json;\n  const ctx = loopItems[i]?.json || {};\n  const keys = d.table_keys || [];\n  const vals = d.table_vals || [];\n  const table = {};\n  keys.forEach((k, idx) => { table[String(k).trim()] = String(vals[idx] || '').trim(); });\n\n  const avail = table['Availability'] || '';\n  const stockMatch = avail.match(/(\\d+)/);\n  const ratingTokens = String(d.rating_raw || '').trim().split(/\\s+/);\n  const breadcrumbs = (d.breadcrumbs || []).map(s => String(s).trim()).filter(Boolean);\n\n  out.push({\n    json: {\n      upc: (table['UPC'] || '').toLowerCase(),\n      title: String(d.title || '').trim(),\n      price: parsePrice(d.price_raw),\n      price_excl_tax: parsePrice(table['Price (excl. tax)']),\n      stock: stockMatch ? parseInt(stockMatch[1], 10) : 0,\n      rating: RATING_MAP[ratingTokens[ratingTokens.length - 1]] || null,\n      reviews: parseInt(table['Number of reviews'] || '0', 10) || 0,\n      category: breadcrumbs.length >= 3 ? breadcrumbs[breadcrumbs.length - 1] : null,\n      category_from_menu: ctx.category_from_menu || 'Fantasy',\n      description: d.description ? String(d.description).trim() : null,\n      url: ctx.url || '',\n      list_page: ctx.list_page || '',\n      scraped_at: new Date().toISOString()\n    }\n  });\n}\nreturn out;"
      },
